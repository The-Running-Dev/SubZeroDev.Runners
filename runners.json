{
  "runnerVersion": "2.338.0",
  "github": {
    "labels": ["subzerodev"]
  },
  "buildAgent": {
    "enabled": true,
    "tool": {
      "package": "BuildAgent.Tool",
      "version": "2.1.0",
      "directory": "%LOCALAPPDATA%\\SubZeroDev\\BuildAgent\\tool"
    },
    "dotnetRuntime": {
      "channel": "8.0",
      "directory": "%LOCALAPPDATA%\\SubZeroDev\\BuildAgent\\dotnet"
    },
    "image": "ghcr.io/the-running-dev/build-agent@sha256:cc13d62b66fab58e264eb583de5c47eb5f49a3ee8a2cdd48f0de0b1d0ba16556",
    "docker": {
      "host": null,
      "readyTimeoutSeconds": 300
    },
    "paths": {
      "workspaceRoot": "%LOCALAPPDATA%\\SubZeroDev\\BuildAgent\\workspaces",
      "outputDirectory": "artifacts",
      "cacheDirectory": ".cache",
      "extraMounts": []
    },
    "cache": {
      "retentionDays": 30,
      "maxGB": 20
    },
    "updater": {
      "version": null,
      "healthTimeout": "120s"
    }
  },
  "windows": {
    "directory": "windows",
    "name": "subzerodev.runner.windows",
    "labels": ["subzerodev-windows"],
    "workFolder": "_work"
  },
  "linux": {
    "directory": "linux/runner",
    "name": "subzerodev.runner.linux",
    "labels": ["subzerodev-linux"],
    "container": "subzerodev-runner-linux",
    "image": "subzerodev-runner-linux:local",
    "cacheVolume": "subzerodev-runner-linux-cache",
    "workFolder": "/tmp/runner-work",
    "cpus": 4,
    "memory": "8g",
    "docker": {
      "mode": "sidecar",
      "image": "docker:29.9.2-dind@sha256:9e79b879b177fbd72c34376a3dd3d91747da5db49e1f560f76aea59561471977",
      "container": "subzerodev-runner-linux-docker",
      "network": "subzerodev-runner-linux",
      "dataVolume": "subzerodev-runner-linux-docker",
      "certsVolume": "subzerodev-runner-linux-docker-certs",
      "workVolume": "subzerodev-runner-linux-work",
      "dindVolume": "subzerodev-runner-linux-dind",
      "cpus": 4,
      "memory": "4g"
    }
  },
  "lifecycle": {
    "drainTimeoutMinutes": 120,
    "pollSeconds": 10,
    "stopTimeoutSeconds": 60,
    "restartDelaySeconds": 30,
    "quickExitSeconds": 300,
    "quickExitLimit": 3,
    "backoffMaxSeconds": 600
  },
  "logs": {
    "retentionDays": 14,
    "maxMB": 512
  },
  "housekeeping": {
    "retries": 20,
    "retryDelaySeconds": 1,
    "minFreeGB": 10
  }
}
